# 필수: 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 선택: 네이버 검색 API (블로그 리뷰, 대체 사진, 네이버 장소 매칭)
# 네이버 클라우드 > NAVER API HUB 에서 발급한 Client ID / Client Secret
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=
# (구) 네이버 개발자센터 검색 API 키. 2026-07-31 이전에 발급받은 키가 있을 때만. HUB 키가 있으면 무시됨
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택: 결과 지도 (카카오 디벨로퍼스 같은 앱의 JavaScript 키, 플랫폼 > Web에 도메인 등록 필요)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 선택: 자유 입력 주제 해석 + 리뷰 기반 재정렬/추천 이유 생성
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# 비공식 리뷰 수집(카카오맵 별점/후기, 네이버 리뷰 수) 사용 여부. 0이면 끔.
UNOFFICIAL_REVIEWS=1

# 1이면 외부 API 대신 가짜 데이터로 동작 (UI 개발용). 카카오 키가 없으면 자동으로 켜짐.
MOCK_MODE=0
