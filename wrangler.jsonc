{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare 대시보드의 Worker 이름과 같아야 한다
	"name": "place",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// 자기 자신을 가리키는 바인딩. service 값도 위 name 과 같아야 한다
			"binding": "WORKER_SELF_REFERENCE",
			"service": "place"
		}
	],
	"kv_namespaces": [
		{
			// 앱에서 고른 지역 목록 등 작은 데이터 (lib/store.ts). 매일 밤 서버 수집이 읽는다
			"binding": "DATA",
			"id": "f467d849f19d4e569de5d0fba93df0cc"
		}
	],
	"d1_databases": [
		{
			// 수집한 식당·분류값 DB (lib/db.ts, migrations/). 매일 밤 GitHub Actions와 앱 수집 결과가 쌓인다
			"binding": "DB",
			"database_name": "matjip",
			"database_id": "034c2ce4-1ab9-4d3b-88f3-3c5fb4e8e59b",
			"migrations_dir": "migrations"
		}
	],
	"observability": { "enabled": true }
}
